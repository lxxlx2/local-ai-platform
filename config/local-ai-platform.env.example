# Placeholders only. Put real values in a local ignored secret file, never here.
PRIVATE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/PRIVATE_DB
PUBLIC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/PUBLIC_DB
S3_ENDPOINT=https://S3_ENDPOINT
S3_REGION=REGION
S3_BUCKET=BUCKET
S3_ACCESS_KEY_ID=PLACEHOLDER_ACCESS_KEY
S3_SECRET_ACCESS_KEY=PLACEHOLDER_SECRET_KEY
EMBEDDING_PROVIDER=provider_pending
DATABASE_BACKEND=sqlite_dev
LOCAL_CACHE_MAX_BYTES=2147483648
LOCAL_PUBLIC_SPOOL_MAX_BYTES=536870912
